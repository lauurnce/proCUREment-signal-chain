{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "worktree": {
    "baseRef": "head"
  },
  "plansDirectory": "./docs/plans",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm dev)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm shots)",
      "Bash(pnpm shots *)",
      "Bash(pnpm vault:reset)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec tsc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git worktree list)",
      "Bash(bash scripts/verify-sole-contributor.sh)",
      "Bash(scripts/verify-sole-contributor.sh)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(gh *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config user.name*)",
      "Bash(git config user.email*)",
      "Bash(git config --global *)"
    ]
  }
}
