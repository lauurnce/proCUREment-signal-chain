# SignalChain HQ local settings.
# Copy to .env and fill in only what you need. Never commit .env.
# Claude Code is not allowed to read .env, so tell Claude the values it needs to know.

# Your seat in the game (the player)
HQ_PLAYER_SEAT=mgr-01
HQ_TIMEZONE=Asia/Manila

# Optional fixed ports. Leave empty to get automatic ports per worktree.
WEB_PORT=
API_PORT=

# Obsidian (optional): the vault name as shown in Obsidian, for "Open in Obsidian" links
OBSIDIAN_VAULT_NAME=

# Mail (Phase 7)
# MAIL_PROVIDER: outbox | graph | power-automate
MAIL_PROVIDER=outbox
# MAIL_MODE: dry-run | drafts | send
MAIL_MODE=drafts
# Comma separated. Sending is blocked for any recipient not in this list.
MAIL_ALLOWED_RECIPIENTS=
# Optional: send every email to this address instead, with a "Demo redirect" banner
MAIL_REDIRECT_TO=
MAIL_MAX_SENDS_PER_HOUR=20
DIGEST_TO=
DIGEST_TIME=17:30
HQ_INBOX_TAG=[HQ]
HQ_INBOX_POLL_SECONDS=120

# Microsoft Graph, only for MAIL_PROVIDER=graph (see docs/OUTLOOK_SETUP.md)
MS_CLIENT_ID=
# consumers = personal Outlook.com accounts only. common = personal plus work or school.
MS_AUTHORITY=https://login.microsoftonline.com/consumers
MS_REDIRECT_PATH=/auth/callback
MS_SCOPES=User.Read Mail.ReadWrite Mail.Send offline_access

# Power Automate bridge (future ADI path, only after IT approval)
PA_BRIDGE_DIR=
